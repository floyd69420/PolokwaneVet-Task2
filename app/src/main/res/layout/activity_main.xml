<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Dashboard"
        android:textColor="#1B4332"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:text="Welcome back, Pet Owner!"
        android:textColor="#666666"
        android:textSize="16sp" />

    <!-- Appointments Button -->
    <Button
        android:id="@+id/btnAppointments"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#1B4332"
        android:text="Book / Manage Appointments"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Settings Button (Required for Task 2) -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2D6A4F"
        android:text="Account Settings"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#B91C1C"
        android:text="Logout"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>